<view class="page">
  <view class="tabs">
    <view
      class="tab {{item.id === activeTab ? 'is-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTabTap"
    >
      <text class="tab-label">{{item.label}}</text>
      <view wx:if="{{item.id === activeTab}}" class="tab-line"></view>
    </view>
  </view>

  <block wx:if="{{activeTab === 'park'}}">
    <view class="intro">
      <text class="intro-desc">园区直接提供的空间、设施和运营支持。这一版先展示目录。</text>
    </view>
    <view class="grid">
      <view
        class="tile"
        wx:for="{{parkServices}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onServiceTap"
      >
        <text class="tile-title">{{item.title}}</text>
        <text class="tile-brief">{{item.brief}}</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{activeTab === 'vendor'}}">
    <view class="intro">
      <text class="intro-desc">合作服务商提供的法律、财税、知识产权等专业能力。这一版为静态展示。</text>
    </view>
    <view class="grid">
      <view
        class="tile"
        wx:for="{{vendorServices}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onServiceTap"
      >
        <text class="tile-title">{{item.title}}</text>
        <text class="tile-brief">{{item.brief}}</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <block wx:if="{{viewState === 'loading'}}">
      <loading-state text="正在加载" />
    </block>
    <block wx:elif="{{viewState === 'error'}}">
      <empty-state title="暂时无法加载" description="请稍后重试" />
      <view class="retry">
        <secondary-button text="重新加载" bind:tap="onRetry" />
      </view>
    </block>
    <block wx:elif="{{opportunities.length}}">
      <view class="stack-item" wx:for="{{opportunities}}" wx:key="id">
        <opportunity-card opportunity="{{item}}" bind:tap="onOpportunityTap" />
      </view>
    </block>
    <empty-state wx:else title="暂无政策机会" description="有新的政策或申报窗口时，会出现在这里。" />
  </block>
</view>
