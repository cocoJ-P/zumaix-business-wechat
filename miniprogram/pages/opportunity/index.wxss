@import '../../styles/lists.wxss';

.filters {
  width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.filters-row {
  display: inline-block;
  padding: 8rpx 0 16rpx;
  white-space: nowrap;
}

.capsule {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 1;
  border-radius: 28rpx;
  vertical-align: middle;
}

.capsule-active {
  background: var(--brand-light);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}
