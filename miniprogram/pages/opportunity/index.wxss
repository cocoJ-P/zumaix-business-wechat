@import '../../styles/lists.wxss';

.page {
  min-height: 100%;
  padding: 0 32rpx 48rpx;
  background: #f4f1eb;
}

.tabs {
  display: flex;
  align-items: stretch;
  margin: 0 -32rpx 8rpx;
  padding: 0 8rpx;
  background: #f4f1eb;
  border-bottom: 1rpx solid rgba(28, 28, 26, 0.06);
}

.tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
}

.tab-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #9199a2;
  line-height: 1.2;
}

.tab.is-active .tab-label {
  color: #0b66e4;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  height: 4rpx;
  background: #0b66e4;
  border-radius: 4rpx;
}

.intro {
  padding: 20rpx 4rpx 20rpx;
}

.intro-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.55;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.tile {
  box-sizing: border-box;
  width: 48.5%;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.tile:active {
  background: #fbfaf7;
}

.tile-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-medium);
  color: var(--text-primary);
  line-height: 1.3;
}

.tile-brief {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.45;
}

.retry {
  margin-top: 24rpx;
}
