.page {
  min-height: 100%;
  padding: 8rpx 36rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.status-copy {
  display: block;
  padding: 32rpx 0;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.6;
}

.retry {
  margin-top: 16rpx;
  padding: 16rpx 8rpx 8rpx;
  font-size: var(--font-md);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}
