@import '../../styles/lists.wxss';

.profile {
  padding: 24rpx 4rpx 8rpx;
}

.kicker {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.profile-name {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xl);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.3;
}

.profile-desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.5;
}

.counts {
  display: flex;
  margin: 8rpx 4rpx 20rpx;
}

.count {
  flex: 1;
}

.count-num {
  display: block;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--brand-primary);
  line-height: 1.2;
}

.count-label {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.reset {
  display: block;
  margin-top: 48rpx;
  padding-bottom: 12rpx;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}
