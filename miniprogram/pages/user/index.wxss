@import '../../styles/lists.wxss';

.profile {
  padding: 24rpx 4rpx 8rpx;
}

.kicker {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.profile-name {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xl);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.3;
}

.profile-desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.5;
}

.identity-card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-secondary);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-md);
}

.identity-name {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-lg);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.35;
}

.identity-user {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}

.identity-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.identity-env {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.backend-row {
  display: flex;
  align-items: center;
}

.backend-label {
  margin-right: 10rpx;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.backend-status {
  display: flex;
  align-items: center;
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.backend-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  flex-shrink: 0;
}

.backend-status--connected {
  color: var(--status-success);
}

.backend-status--connected .backend-dot {
  background: var(--status-success);
}

.backend-status--unavailable {
  color: var(--status-danger);
}

.backend-status--unavailable .backend-dot {
  background: var(--status-danger);
}

.counts {
  display: flex;
  margin: 8rpx 4rpx 20rpx;
}

.count {
  flex: 1;
}

.count-num {
  display: block;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--brand-primary);
  line-height: 1.2;
}

.count-label {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.reset {
  display: block;
  margin-top: 48rpx;
  padding-bottom: 12rpx;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}
