.page {
  min-height: 100%;
  padding: 24rpx 36rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.lead {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.6;
}

.group {
  margin-top: 16rpx;
}

.group-title {
  display: block;
  padding: 18rpx 0 4rpx;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0 26rpx;
  border-bottom: 1rpx solid rgba(28, 28, 26, 0.05);
}

.row-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.action {
  flex-shrink: 0;
  padding-top: 28rpx;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.action-done {
  color: var(--brand-primary);
}

.status {
  display: flex;
  align-items: center;
}

.status text {
  font-size: var(--font-xs);
  color: var(--brand-primary);
  letter-spacing: 0.04em;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-live {
  background: var(--brand-primary);
}

.dot-wait {
  background: #c4c1b8;
}

.dot-done {
  background: var(--brand-primary);
  box-shadow: 0 0 0 4rpx rgba(31, 107, 92, 0.12);
}

.status .dot-wait + text {
  color: var(--text-secondary);
}

.status .dot-done + text {
  color: var(--brand-primary);
}

.group .row:last-child {
  border-bottom: none;
}

.title {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-md);
  font-weight: var(--font-medium);
  color: var(--text-primary);
  line-height: 1.45;
}

.note {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}
