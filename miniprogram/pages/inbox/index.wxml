<view class="page">
  <text class="lead">分析完成的内容会回到首页。正在分析的步骤会逐项打钩，不会互相覆盖。</text>
  <block wx:if="{{groups.length}}">
    <view class="group" wx:for="{{groups}}" wx:for-item="group" wx:for-index="gIndex" wx:key="key">
      <text class="group-title">{{group.title}}</text>
      <view
        class="row"
        wx:for="{{group.items}}"
        wx:for-item="item"
        wx:for-index="itemIndex"
        wx:key="id"
        bindtap="onOpenItem"
        data-id="{{item.id}}"
      >
        <view class="row-main">
          <view class="status">
            <view class="dot {{item.status === 'analyzing' ? 'dot-live' : (item.status === 'done' ? 'dot-done' : 'dot-wait')}}"></view>
            <text>{{item.statusLabel}}</text>
          </view>
          <text class="title">{{item.title}}</text>
          <analyze-checklist wx:if="{{item.status === 'analyzing'}}" steps="{{item.steps}}" compact="{{true}}" />
          <text wx:else class="note">{{item.noteText}}</text>
        </view>
        <text wx:if="{{item.status !== 'analyzing'}}" class="action {{item.status === 'done' ? 'action-done' : ''}}">{{item.actionLabel}}</text>
      </view>
    </view>
  </block>
  <empty-state wx:else title="暂无待处理事项" description="右滑推荐卡，或从剪贴板、转发加入" />
</view>
