.page {
  min-height: 100%;
  padding: 24rpx 36rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.header {
  padding: 8rpx 0 12rpx;
}

.type {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  letter-spacing: 0.04em;
}

.title {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.32;
}

.publisher {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.deadline,
.status {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.status {
  color: var(--brand-primary);
}

.follow {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.section {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(28, 28, 26, 0.06);
}

.kicker {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.facts .fact {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.5;
}

.lead-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-medium);
  color: var(--text-primary);
}

.lead-meta,
.lead-note {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.6;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(28, 28, 26, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 36rpx;
}

.dialog {
  width: 100%;
  padding: 40rpx 36rpx 32rpx;
  background: #f7f4ee;
  border-radius: 24rpx;
}

.dialog-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
}

.dialog-body {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.65;
  white-space: pre-wrap;
}

.dialog-actions {
  margin-top: 32rpx;
}

.dialog-btn {
  width: 100%;
}

.dialog-btn-gap {
  margin-top: 16rpx;
}
