.page {
  min-height: 100%;
  padding: 32rpx 36rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.event {
  display: flex;
  align-items: baseline;
}

.kind,
.status {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.status {
  color: var(--text-primary);
  font-weight: var(--font-medium);
}

.sep {
  margin: 0 10rpx;
  color: var(--text-tertiary);
}

.title {
  display: block;
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.3;
  white-space: pre-wrap;
}

.reason {
  display: block;
  margin-top: 24rpx;
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.65;
}

.note {
  display: block;
  margin-top: 48rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.6;
}

.actions {
  margin-top: 48rpx;
}
