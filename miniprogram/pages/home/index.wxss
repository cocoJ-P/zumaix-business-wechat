page {
  height: 100%;
  overflow: hidden;
}

.page-scroll {
  height: 100%;
  box-sizing: border-box;
}

.page {
  min-height: 100%;
  padding-right: 36rpx;
  padding-left: 36rpx;
  padding-bottom: 48rpx;
  overflow-x: hidden;
  width: 100%;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  margin-bottom: 24rpx;
}

.brand-name {
  display: block;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.15;
  letter-spacing: 0.02em;
  text-align: center;
}

.brand-tagline {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.4;
  text-align: center;
}

.check-entry {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 48rpx;
  padding: 16rpx 16rpx 16rpx 24rpx;
  background: #f7f4ee;
  border: 1rpx solid rgba(31, 107, 92, 0.1);
  border-radius: var(--radius-lg);
}

.check-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 56rpx;
}

.check-placeholder {
  font-size: var(--font-md);
  color: var(--text-tertiary);
}

.check-action,
.check-cta {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  font-size: var(--font-md);
  font-weight: var(--font-medium);
  line-height: 1.3;
}

.check-action {
  color: var(--text-secondary);
}

.check-cta {
  color: var(--brand-primary);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.section-meta {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.section-action {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}

.reco-section {
  margin-bottom: 8rpx;
}

.reco-status {
  padding: 8rpx 0 20rpx;
}

.status-copy {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.6;
}

.status-retry {
  display: inline-block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}

.reco-empty {
  padding: 4rpx 0 20rpx;
}

.reco-empty-title {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}

.reco-empty-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.5;
}

.discover-section {
  margin-top: 20rpx;
}

.discover-placeholder {
  min-height: 240rpx;
  padding: 48rpx 8rpx 24rpx;
}

.discover-loading {
  font-size: var(--font-md);
  color: var(--text-tertiary);
  line-height: 1.6;
}

.discover-retry {
  margin-top: 16rpx;
  padding: 16rpx 8rpx 8rpx;
  font-size: var(--font-md);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}

.deck {
  position: relative;
  overflow: visible;
}

.current-slot.is-entering {
  animation: deck-in 260ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes deck-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.current-slot {
  display: block;
  height: auto;
}

.peek {
  margin-top: 16rpx;
  height: 168rpx;
  overflow: hidden;
  pointer-events: none;
}

.peek-card {
  box-sizing: border-box;
  height: auto;
  padding: 32rpx 32rpx 28rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.peek-card.visual-fresh {
  background: linear-gradient(158deg, #e6f0ea 0%, #e7eef6 36%, #ece8f3 70%, #f5f0e6 100%);
}

.peek-card.visual-plain {
  background: #f7f4ee;
  border: 1rpx solid rgba(28, 28, 26, 0.07);
}

.peek-event {
  display: flex;
  align-items: baseline;
}

.peek-kind {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  letter-spacing: 0.04em;
}

.peek-sep {
  margin: 0 10rpx;
  color: var(--text-tertiary);
}

.peek-status {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: var(--font-medium);
}

.peek-title {
  display: block;
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.28;
}
