page {
  height: 100%;
  overflow: hidden;
}

.page-scroll {
  height: 100%;
  box-sizing: border-box;
}

.page {
  min-height: 100%;
  padding-right: 36rpx;
  padding-left: 36rpx;
  padding-bottom: 48rpx;
  overflow-x: hidden;
  width: 100%;
}

.brand {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.brand-main {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.brand-name {
  display: block;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.15;
  letter-spacing: 0.02em;
}

.brand-tagline {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.4;
}

.provider {
  display: flex;
  align-items: center;
  padding-top: 4rpx;
  max-width: 240rpx;
}

.provider-logo {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.provider-copy {
  min-width: 0;
}

.provider-name {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.3;
}

.provider-role {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.discover-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 28rpx;
  margin-bottom: 16rpx;
}

.discover-title {
  font-size: 34rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.discover-index {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.deck {
  position: relative;
  overflow: visible;
}

.current-slot.is-entering {
  animation: deck-in 260ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes deck-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.peek {
  margin-top: 16rpx;
  max-height: 176rpx;
  overflow: hidden;
  pointer-events: none;
}

.low {
  margin-top: 128rpx;
}

.low-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.low-title {
  font-size: var(--font-md);
  color: var(--text-secondary);
  font-weight: var(--font-medium);
}

.low-count {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.low-item {
  margin-bottom: 12rpx;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(28, 28, 26, 0.32);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 48rpx 36rpx calc(env(safe-area-inset-bottom) + 36rpx);
}

.sheet {
  width: 100%;
  padding: 28rpx 8rpx 12rpx;
  background: #f7f4ee;
  border-radius: 24rpx;
}

.sheet-kicker {
  display: block;
  padding: 4rpx 24rpx 16rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.sheet-item {
  display: block;
  padding: 28rpx 24rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.sheet-cancel {
  display: block;
  margin-top: 4rpx;
  padding: 28rpx 24rpx 16rpx;
  font-size: var(--font-md);
  color: var(--text-tertiary);
}

.dialog {
  width: 100%;
  margin-bottom: 120rpx;
  padding: 40rpx 36rpx 32rpx;
  background: #f7f4ee;
  border-radius: 24rpx;
  align-self: center;
}

.dialog-kicker {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.dialog-body {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.6;
}

.compose {
  width: 100%;
  min-height: 160rpx;
  margin-top: 20rpx;
  padding: 20rpx 0;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.6;
}

.compose-ph {
  color: var(--text-tertiary);
}

.dialog-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  margin-top: 28rpx;
}

.dialog-ignore {
  padding: 12rpx 20rpx;
  font-size: var(--font-md);
  color: var(--text-tertiary);
}

.dialog-accept {
  margin-left: 8rpx;
  padding: 12rpx 20rpx;
  font-size: var(--font-md);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}
