page {
  height: 100%;
  overflow: hidden;
  background: #4f739f;
}

.page-scroll {
  height: 100%;
  box-sizing: border-box;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding-top: 12rpx;
  padding-bottom: 0;
  overflow: visible;
  width: 100%;
  background: #f4f1eb;
}

.hero-band {
  background: var(--brand-hero);
  overflow: hidden;
}

.herotitle-image {
  display: block;
  width: 100%;
  margin-top: -28rpx;
  margin-bottom: -40rpx;
}

.check-entry {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  margin-right: 36rpx;
  margin-bottom: 28rpx;
  margin-left: 36rpx;
  padding: 12rpx 12rpx 12rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(28, 28, 26, 0.06);
  border-radius: 999rpx;
}

.quick-entries {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-right: 36rpx;
  margin-bottom: 24rpx;
  margin-left: 36rpx;
  padding: 0 8rpx;
}

.quick-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 25%;
  height: 76rpx;
  background: transparent;
  border-radius: 16rpx;
}

.quick-entry:active {
  background: rgba(0, 91, 172, 0.06);
}

.quick-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #5f666c;
  line-height: 1.3;
  text-align: center;
}

.check-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 56rpx;
}

.check-placeholder {
  font-size: var(--font-md);
  color: var(--text-tertiary);
}

.check-cta {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  background: var(--brand-hero);
  border-radius: 999rpx;
  font-size: var(--font-md);
  font-weight: var(--font-medium);
  line-height: 1.3;
  color: #ffffff;
}

.content-band {
  flex: 1;
  padding: 28rpx 36rpx 80rpx;
  background: #4f739f;
  border-radius: 20rpx 20rpx 0 0;
  overflow: visible;
}

.content-band .section-title {
  color: #f8fafc;
}

.content-band .section-action,
.content-band .section-meta {
  color: rgba(255, 255, 255, 0.76);
}

.content-band .status-copy,
.content-band .reco-empty-title,
.content-band .discover-loading,
.content-band .wrap .title {
  color: rgba(255, 255, 255, 0.94);
}

.content-band .reco-empty-sub,
.content-band .wrap .desc {
  color: rgba(255, 255, 255, 0.76);
}

.content-band .status-retry,
.content-band .discover-retry {
  color: rgba(255, 255, 255, 0.76);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.section-meta {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.section-action {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}

.reco-section {
  margin-bottom: 8rpx;
}

.reco-status {
  padding: 8rpx 0 20rpx;
}

.status-copy {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.6;
}

.status-retry {
  display: inline-block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}

.reco-empty {
  padding: 4rpx 0 20rpx;
}

.reco-empty-title {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}

.reco-empty-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.5;
}

.discover-section {
  margin-top: 20rpx;
}

.discover-placeholder {
  min-height: 240rpx;
  padding: 48rpx 8rpx 24rpx;
}

.discover-loading {
  font-size: var(--font-md);
  color: var(--text-tertiary);
  line-height: 1.6;
}

.discover-retry {
  margin-top: 16rpx;
  padding: 16rpx 8rpx 8rpx;
  font-size: var(--font-md);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}

.deck {
  position: relative;
  overflow: visible;
  z-index: 2;
}

.current-slot.is-entering {
  animation: deck-in 260ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes deck-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.current-slot {
  display: block;
  height: auto;
}

.peek {
  margin-top: 16rpx;
  height: 168rpx;
  overflow: hidden;
  pointer-events: none;
}

.peek-card {
  position: relative;
  box-sizing: border-box;
  height: auto;
  padding: 32rpx 32rpx 28rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.peek-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.peek-scrim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  pointer-events: none;
}

.peek-event,
.peek-title {
  position: relative;
  z-index: 2;
}

.peek-card.visual-fresh {
  background: linear-gradient(158deg, #e6f0ea 0%, #e7eef6 36%, #ece8f3 70%, #f5f0e6 100%);
}

.peek-card.has-theme {
  background-image: none;
}

.peek-card.ink-light .peek-kind,
.peek-card.ink-light .peek-status,
.peek-card.ink-light .peek-title {
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 24, 72, 0.28);
}

.peek-card.ink-light .peek-sep {
  color: rgba(255, 255, 255, 0.78);
}

.peek-card.ink-dark.has-theme .peek-kind,
.peek-card.ink-dark.has-theme .peek-status,
.peek-card.ink-dark.has-theme .peek-title {
  text-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.7);
}

.peek-card.visual-plain {
  background: #f7f4ee;
  border: 1rpx solid rgba(28, 28, 26, 0.07);
}

.peek-event {
  display: flex;
  align-items: baseline;
  max-width: 68%;
}

.peek-kind {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  letter-spacing: 0.04em;
}

.peek-sep {
  margin: 0 10rpx;
  color: var(--text-tertiary);
}

.peek-status {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: var(--font-medium);
}

.peek-title {
  display: block;
  margin-top: 20rpx;
  max-width: 68%;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.28;
}
