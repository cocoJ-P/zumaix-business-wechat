<page-meta page-style="overflow: hidden;" />

<scroll-view
  class="page-scroll"
  scroll-y="{{!gesture.active}}"
  scroll-x="{{false}}"
  show-scrollbar="{{false}}"
  enhanced
  bounces="{{true}}"
  refresher-enabled="{{true}}"
  refresher-triggered="{{homeRefreshing}}"
  refresher-background="#015DDE"
  bindrefresherrefresh="onHomeRefresh"
>
  <view class="hero-band" style="padding-top: {{paddingTopPx}}px;">
    <image
      class="herotitle-image"
      src="/images/brand/herotitle.png"
      mode="widthFix"
      show-menu-by-longpress="{{false}}"
    />
  </view>
<view class="page">

  <view class="check-entry">
    <input
      class="check-input"
      value="{{composeText}}"
      maxlength="8000"
      confirm-type="search"
      hold-keyboard
      placeholder="有需求？先查查"
      placeholder-class="check-placeholder"
      bindinput="onComposeInput"
      bindconfirm="onComposeCheck"
    />
    <text class="check-cta" catchtap="onComposeCheck">查查</text>
  </view>

  <view class="quick-entries">
    <view
      class="quick-entry"
      wx:for="{{quickEntries}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onQuickEntryTap"
    >
      <text class="quick-label">{{item.label}}</text>
    </view>
  </view>

  <view class="content-band">
  <view class="section reco-section">
    <view class="section-head">
      <text class="section-title">待处理</text>
      <text class="section-action" bindtap="onOpenAllRecommended">显示全部</text>
    </view>

    <block wx:if="{{recommendedLoading}}">
      <view class="reco-status">
        <text class="status-copy">正在加载内容…</text>
      </view>
    </block>
    <block wx:elif="{{recommendedError}}">
      <view class="reco-status">
        <text class="status-copy">暂时无法加载内容</text>
        <text class="status-retry" bindtap="onRetryRecommended">重新加载</text>
      </view>
    </block>
    <block wx:elif="{{!recommendedItems.length}}">
      <view class="reco-empty">
        <text class="reco-empty-title">还没有解析完成的内容</text>
        <text class="reco-empty-sub">粘贴链接、内容，或右滑你想继续了解的发现。</text>
      </view>
    </block>
    <block wx:else>
      <recommended-list items="{{recommendedItems}}" compact="{{true}}" inverse="{{true}}" bind:itemtap="onOpenRecommended" />
    </block>
  </view>

  <view class="section discover-section">
    <view class="section-head">
      <text class="section-title">为您推送</text>
      <text wx:if="{{discoveryCount}}" class="section-meta">{{discoveryCount}} 条发现</text>
    </view>

    <block wx:if="{{discoveryLoading}}">
      <view class="discover-placeholder">
        <text class="discover-loading">正在发现适合你的机会…</text>
      </view>
    </block>
    <block wx:elif="{{discoveryError}}">
      <empty-state title="暂时无法加载「为您推送」" description="{{discoveryErrorMessage}}" />
      <view class="discover-retry" bindtap="onRetryDiscovery">重新加载</view>
    </block>
    <block wx:elif="{{!current}}">
      <empty-state title="暂时没有新的发现" description="有新的机会或服务内容时，会出现在这里。" />
    </block>
    <block wx:else>
      <view class="deck">
        <view class="current-slot {{deckEntering ? 'is-entering' : ''}}">
          <discovery-card
            item="{{current}}"
            size="large"
            locked="{{feedbackLocked}}"
            bind:gesturechange="onGestureChange"
            bind:decision="onDecision"
            bind:save="onSaveDiscovery"
            bind:deprioritize="onDeprioritizeDiscovery"
            bind:open="onOpenDiscovery"
          />
        </view>
          <view wx:if="{{next}}" class="peek">
          <view
            class="peek-card visual-{{next.visualState === 'deprioritized' ? 'plain' : 'fresh'}} ink-{{next.ink === 'light' ? 'light' : 'dark'}} {{peekCardStyle ? 'has-theme' : ''}}"
            style="{{peekCardStyle}}"
          >
            <image
              wx:if="{{next.backgroundImage && next.visualState !== 'deprioritized' && !peekBgFailed}}"
              class="peek-bg"
              src="{{next.backgroundImage}}"
              mode="aspectFill"
              binderror="onPeekBgError"
            />
            <view wx:if="{{peekScrimStyle && !peekBgFailed}}" class="peek-scrim" style="{{peekScrimStyle}}"></view>
            <view wx:if="{{next.kind || next.eventStatus}}" class="peek-event">
              <text wx:if="{{next.kind}}" class="peek-kind">{{next.kind}}</text>
              <text wx:if="{{next.kind && next.eventStatus}}" class="peek-sep">·</text>
              <text wx:if="{{next.eventStatus}}" class="peek-status">{{next.eventStatus}}</text>
            </view>
            <text class="peek-title">{{next.title}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
  </view>
</view>
</scroll-view>

<decision-overlay
  active="{{gesture.active}}"
  direction="{{gesture.direction}}"
  progress="{{gesture.progress}}"
  armed="{{gesture.armed}}"
  committed="{{gesture.committed}}"
  rawDx="{{gesture.rawDx}}"
/>

