.page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.loading {
  padding-top: 72rpx;
}

.loading-kicker {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

.loading-copy {
  display: block;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.7;
}

.invalid {
  padding-top: 80rpx;
}

.result {
  padding-top: 12rpx;
}

.eyebrow {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.headline {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.35;
}

.subhead,
.source-url,
.excerpt {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.6;
}

.source-url {
  word-break: break-all;
}

.excerpt {
  color: var(--text-tertiary);
}

.facts {
  margin-top: 8rpx;
}

.fact {
  margin-top: 18rpx;
}

.fact-label {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.fact-value {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.note,
.caution,
.disclaimer {
  display: block;
  margin-top: 20rpx;
  font-size: var(--font-md);
  line-height: 1.65;
}

.note {
  color: var(--text-primary);
}

.caution {
  color: var(--status-warning);
}

.disclaimer {
  margin-top: 40rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.block {
  margin-top: 40rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(28, 28, 26, 0.06);
}

.list {
  margin-top: 16rpx;
}

.list-item,
.evidence-text {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.65;
}

.evidence {
  margin-top: 16rpx;
}

.link {
  display: block;
  margin-top: 20rpx;
  font-size: var(--font-sm);
  color: var(--brand-primary);
}

.action {
  margin-top: 48rpx;
}
