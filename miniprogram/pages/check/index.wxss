.page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.loading {
  padding-top: 72rpx;
}

.loading-kicker {
  display: block;
  margin-bottom: 20rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

.invalid {
  padding-top: 80rpx;
}

.result {
  padding-top: 12rpx;
}

.eyebrow {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.headline {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.35;
}

.facts {
  margin-top: 32rpx;
}

.fact {
  margin-top: 18rpx;
}

.fact-label {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.fact-value {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.note,
.found,
.caution {
  display: block;
  margin-top: 28rpx;
  font-size: var(--font-md);
  line-height: 1.65;
}

.note {
  color: var(--text-primary);
}

.found {
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}

.caution {
  color: var(--status-warning);
}

.block {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(28, 28, 26, 0.06);
}

.action {
  margin-top: 48rpx;
}
