<view class="page">
  <view wx:if="{{phase === 'invalid'}}" class="invalid">
    <empty-state title="没有可查的内容" description="请从首页粘贴链接或正文后再开始查查。" />
    <view class="action">
      <primary-button text="返回首页" bind:tap="onBackHome" />
    </view>
  </view>

  <view wx:elif="{{phase === 'error'}}" class="invalid">
    <empty-state title="查查失败" description="这次判断没有完成，请稍后重试。" />
    <view class="action">
      <primary-button text="返回首页" bind:tap="onBackHome" />
    </view>
  </view>

  <view wx:elif="{{phase === 'loading'}}" class="loading">
    <text class="loading-kicker">正在分析</text>
    <analyze-checklist steps="{{steps}}" />
  </view>

  <view wx:elif="{{result}}" class="result">
    <text class="eyebrow">你正在查看</text>
    <text class="headline">{{result.submittedKindLabel}}</text>

    <view class="facts">
      <view class="fact">
        <text class="fact-label">内容性质</text>
        <text class="fact-value">{{result.natureLabel}}</text>
      </view>
      <view wx:if="{{result.marketingLevel}}" class="fact">
        <text class="fact-label">营销程度</text>
        <text class="fact-value">{{result.marketingLevel}}</text>
      </view>
      <view class="fact">
        <text class="fact-label">是否存在真实政策</text>
        <text class="fact-value">{{result.hasRealPolicy ? '是' : '暂未确认'}}</text>
      </view>
      <view wx:if="{{result.mustUseAgency}}" class="fact">
        <text class="fact-label">是否必须通过该机构办理</text>
        <text class="fact-value">{{result.mustUseAgency}}</text>
      </view>
    </view>

    <text wx:if="{{result.notOriginal}}" class="note">当前内容不是原始政策</text>
    <text wx:if="{{result.hasRealPolicy && result.foundOpportunity}}" class="found">{{result.foundMessage}}</text>
    <text wx:if="{{result.caution}}" class="caution">{{result.caution}}</text>

    <view class="block">
      <source-provenance
        nodes="{{result.provenance}}"
        publisher="{{result.officialPublisher}}"
        document="{{result.officialDocument}}"
        publishedAt="{{result.publishedAt}}"
        verified="{{result.verified}}"
        unverified="{{!result.verified}}"
        showOfficialAction="{{result.verified}}"
        bind:official="onOpenOfficial"
      />
    </view>

    <view class="action">
      <primary-button
        wx:if="{{result.foundOpportunity && result.verified}}"
        text="查看真实机会"
        bind:tap="onOpenOpportunity"
      />
      <secondary-button
        wx:elif="{{result.opportunityId}}"
        text="查看识别结果"
        bind:tap="onOpenOpportunity"
      />
    </view>
  </view>
</view>
