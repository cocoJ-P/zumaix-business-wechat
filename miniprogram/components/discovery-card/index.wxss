.swipe {
  display: block;
  position: relative;
  overflow: visible;
  border-radius: var(--radius-xl);
}

.swipe-large,
.mover-large,
.stage,
.flip {
  height: auto;
}

.swipe-large,
.swipe-large .mover,
.swipe-large .stage,
.swipe-large .flip {
  width: 100%;
  height: 480rpx;
}

.mover {
  position: relative;
  z-index: 1;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
}

.mover-large {
  overflow: visible;
  box-shadow: var(--shadow-lift);
  border-radius: var(--radius-xl);
  transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 200ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 200ms ease-out;
  -webkit-transition: -webkit-transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 200ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 200ms ease-out;
}

.mover-large.is-deciding {
  z-index: 3;
  box-shadow: 0 18rpx 48rpx rgba(28, 28, 26, 0.1);
  transition: none;
  -webkit-transition: none;
}

.mover-large.is-committing {
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 220ms cubic-bezier(0.22, 1, 0.36, 1);
  -webkit-transition: -webkit-transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.stage {
  perspective: 1400px;
  -webkit-perspective: 1400px;
  overflow: visible;
}

.flip {
  position: relative;
  overflow: visible;
  transform: rotateY(0deg);
  -webkit-transform: rotateY(0deg);
  transition: transform 0.22s ease-in;
  -webkit-transition: -webkit-transform 0.22s ease-in;
}

.flip.is-turning {
  transform: rotateY(90deg);
  -webkit-transform: rotateY(90deg);
}

.face-front,
.face-back {
  position: relative;
  z-index: 1;
}

.card {
  position: relative;
  box-sizing: border-box;
  padding: 32rpx 32rpx 28rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.card-large {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 480rpx;
  min-height: 480rpx;
  max-height: 480rpx;
  overflow: hidden;
}

.card-compact {
  min-height: 0;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: none;
  background: #efece6;
}

.visual-fresh {
  background: linear-gradient(158deg, #e6f0ea 0%, #e7eef6 36%, #ece8f3 70%, #f5f0e6 100%);
}

.visual-plain {
  background: #f7f4ee;
  border: 1rpx solid rgba(28, 28, 26, 0.07);
  box-shadow: 0 10rpx 28rpx rgba(28, 28, 26, 0.045);
}

.aurora {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.aurora-a {
  width: 560rpx;
  height: 560rpx;
  top: -220rpx;
  left: -160rpx;
  background: radial-gradient(circle, rgba(47, 118, 102, 0.34) 0%, rgba(47, 118, 102, 0) 68%);
}

.aurora-b {
  width: 480rpx;
  height: 480rpx;
  top: 48rpx;
  right: -180rpx;
  background: radial-gradient(circle, rgba(92, 128, 176, 0.26) 0%, rgba(92, 128, 176, 0) 70%);
}

.aurora-c {
  width: 420rpx;
  height: 420rpx;
  right: 48rpx;
  bottom: -180rpx;
  background: radial-gradient(circle, rgba(168, 148, 196, 0.2) 0%, rgba(232, 214, 176, 0.12) 42%, rgba(168, 148, 196, 0) 72%);
}

.card-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.face-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  flex: 1;
  width: 100%;
  min-height: 0;
  height: 100%;
  overflow: hidden;
  background: none;
  background-color: transparent;
}

.face-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: none;
  background-color: transparent;
}

.event {
  display: flex;
  align-items: baseline;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.kind,
.status {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.kind {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  letter-spacing: 0.04em;
}

.sep {
  margin: 0 10rpx;
  color: var(--text-tertiary);
}

.status {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: var(--font-medium);
}

.title {
  display: -webkit-box;
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.28;
  letter-spacing: 0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.face-back .title {
  -webkit-line-clamp: 2;
}

.reason {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.action {
  display: block;
  flex-shrink: 0;
  margin-top: auto;
  padding-top: 24rpx;
  font-size: var(--font-md);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}

.note {
  display: block;
  margin-top: 28rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.back-fact {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
  min-width: 0;
}

.fact-label {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.fact-value {
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.back-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 24rpx;
}

.back-link {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  padding: 8rpx 0;
}

.back-actions .action {
  margin-top: 0;
}

.compact-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.compact-bottom {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.compact-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chevron {
  margin-left: 12rpx;
  color: var(--text-tertiary);
  font-size: 40rpx;
  line-height: 1;
}
