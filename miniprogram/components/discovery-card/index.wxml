<view class="swipe swipe-{{size}}">
  <view
    class="mover mover-{{size}} {{deciding ? 'is-deciding' : ''}} {{settling ? 'is-settling' : ''}} {{committing ? 'is-committing' : ''}}"
    style="{{moverStyle}}"
    catchtouchstart="onStart"
    catchtouchmove="onMove"
    bindtouchend="onEnd"
    bindtouchcancel="onEnd"
  >
    <view class="stage">
      <view class="flip {{turning ? 'is-turning' : ''}}">
        <view
          wx:if="{{!flipped}}"
          class="face face-front card card-{{size}} visual-{{item.visualState === 'deprioritized' ? 'plain' : 'fresh'}} ink-{{ink}} {{showPhoto ? 'has-photo' : ''}} {{cardFaceStyle ? 'has-theme' : ''}}"
          style="{{cardFaceStyle}}"
          catchtap="onTap"
        >
          <image
            wx:if="{{showPhoto}}"
            class="card-bg"
            src="{{item.backgroundImage}}"
            mode="aspectFill"
            binderror="onBgError"
          />
          <view wx:if="{{scrimStyle}}" class="card-scrim" style="{{scrimStyle}}"></view>
          <view class="face-content" style="background: none; background-color: transparent;">
            <block wx:if="{{size === 'large'}}">
              <view class="face-body">
                <view wx:if="{{item.kind || item.eventStatus}}" class="event">
                  <text wx:if="{{item.kind}}" class="kind">{{item.kind}}</text>
                  <text wx:if="{{item.kind && item.eventStatus}}" class="sep">·</text>
                  <text wx:if="{{item.eventStatus}}" class="status">{{item.eventStatus}}</text>
                </view>
                <text class="title">{{item.title}}</text>
                <text wx:if="{{item.reason}}" class="reason">{{item.reason}}</text>
              </view>
            </block>
            <block wx:else>
              <view class="compact-top">
                <text class="kind">{{item.kind}}</text>
                <text class="status">{{item.eventStatus}}</text>
              </view>
              <view class="compact-bottom">
                <text class="compact-title">{{displayTitle}}</text>
                <text class="chevron">›</text>
              </view>
            </block>
          </view>
        </view>

        <view
          wx:else
          class="face face-back card card-large visual-{{item.visualState === 'deprioritized' ? 'plain' : 'fresh'}} ink-{{ink}} {{cardFaceStyle ? 'has-theme' : ''}}"
          style="{{cardFaceStyle}}"
          catchtap="onFlipBack"
        >
          <view class="face-content" style="background: none; background-color: transparent;">
            <view class="face-body">
              <view wx:if="{{item.kind || item.eventStatus}}" class="event">
                <text wx:if="{{item.kind}}" class="kind">{{item.kind}}</text>
                <text wx:if="{{item.kind && item.eventStatus}}" class="sep">·</text>
                <text wx:if="{{item.eventStatus}}" class="status">{{item.eventStatus}}</text>
              </view>
              <text class="title">{{item.title}}</text>
              <text wx:if="{{item.summary}}" class="reason">{{item.summary}}</text>
              <view wx:if="{{item.issuer}}" class="back-fact">
                <text class="fact-label">{{item.issuerLabel}}</text>
                <text class="fact-value">{{item.issuer}}</text>
              </view>
              <view wx:if="{{item.region}}" class="back-fact">
                <text class="fact-label">地区</text>
                <text class="fact-value">{{item.region}}</text>
              </view>
              <view wx:if="{{item.deadlineText}}" class="back-fact">
                <text class="fact-label">截止时间</text>
                <text class="fact-value">{{item.deadlineText}}</text>
              </view>
              <text wx:if="{{item.hasReferenceSource}}" class="note">有参考来源</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
