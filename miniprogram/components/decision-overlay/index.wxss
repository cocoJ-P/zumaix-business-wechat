.overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  pointer-events: none;
  overflow: hidden;
}

.edge {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  opacity: 0;
  transition: opacity 160ms ease-out;
  -webkit-transition: opacity 160ms ease-out;
}

.edge-left {
  justify-content: flex-start;
}

.edge-right {
  justify-content: flex-end;
}

.frost {
  position: absolute;
  top: 0;
  bottom: 0;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.edge-left .frost-1,
.edge-left .frost-2,
.edge-left .frost-3 {
  left: 0;
}

.edge-right .frost-1,
.edge-right .frost-2,
.edge-right .frost-3 {
  right: 0;
}

.edge-left .frost-1 {
  width: 38%;
  background: rgba(244, 241, 235, 0.28);
  -webkit-backdrop-filter: blur(28px);
  backdrop-filter: blur(28px);
  -webkit-mask-image: linear-gradient(
    90deg,
    #000 0%,
    #000 10%,
    rgba(0, 0, 0, 0.55) 36%,
    transparent 100%
  );
  mask-image: linear-gradient(
    90deg,
    #000 0%,
    #000 10%,
    rgba(0, 0, 0, 0.55) 36%,
    transparent 100%
  );
}

.edge-left .frost-2 {
  width: 54%;
  background: rgba(244, 241, 235, 0.14);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  -webkit-mask-image: linear-gradient(
    90deg,
    #000 0%,
    rgba(0, 0, 0, 0.4) 32%,
    transparent 100%
  );
  mask-image: linear-gradient(
    90deg,
    #000 0%,
    rgba(0, 0, 0, 0.4) 32%,
    transparent 100%
  );
}

.edge-left .frost-3 {
  width: 70%;
  background: rgba(244, 241, 235, 0.06);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.65) 0%, transparent 100%);
  mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.65) 0%, transparent 100%);
}

.edge-right .frost-1 {
  width: 38%;
  background: rgba(232, 242, 239, 0.28);
  -webkit-backdrop-filter: blur(28px);
  backdrop-filter: blur(28px);
  -webkit-mask-image: linear-gradient(
    270deg,
    #000 0%,
    #000 10%,
    rgba(0, 0, 0, 0.55) 36%,
    transparent 100%
  );
  mask-image: linear-gradient(
    270deg,
    #000 0%,
    #000 10%,
    rgba(0, 0, 0, 0.55) 36%,
    transparent 100%
  );
}

.edge-right .frost-2 {
  width: 54%;
  background: rgba(232, 242, 239, 0.14);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  -webkit-mask-image: linear-gradient(
    270deg,
    #000 0%,
    rgba(0, 0, 0, 0.4) 32%,
    transparent 100%
  );
  mask-image: linear-gradient(
    270deg,
    #000 0%,
    rgba(0, 0, 0, 0.4) 32%,
    transparent 100%
  );
}

.edge-right .frost-3 {
  width: 70%;
  background: rgba(232, 242, 239, 0.06);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  -webkit-mask-image: linear-gradient(270deg, rgba(0, 0, 0, 0.65) 0%, transparent 100%);
  mask-image: linear-gradient(270deg, rgba(0, 0, 0, 0.65) 0%, transparent 100%);
}

.wash {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.edge-left .wash {
  background: linear-gradient(
    90deg,
    rgba(168, 154, 128, 0.4) 0%,
    rgba(168, 154, 128, 0.18) 16%,
    rgba(168, 154, 128, 0.06) 34%,
    rgba(168, 154, 128, 0) 56%
  );
}

.edge-right .wash {
  background: linear-gradient(
    270deg,
    rgba(31, 107, 92, 0.36) 0%,
    rgba(31, 107, 92, 0.16) 16%,
    rgba(31, 107, 92, 0.05) 34%,
    rgba(31, 107, 92, 0) 56%
  );
}

.bloom {
  position: absolute;
  top: 50%;
  width: 420rpx;
  height: 520rpx;
  margin-top: -260rpx;
}

.edge-left .bloom {
  left: -120rpx;
  background: radial-gradient(
    ellipse at left center,
    rgba(168, 154, 128, 0.28) 0%,
    rgba(168, 154, 128, 0.1) 42%,
    rgba(168, 154, 128, 0) 74%
  );
}

.edge-right .bloom {
  right: -120rpx;
  background: radial-gradient(
    ellipse at right center,
    rgba(31, 107, 92, 0.26) 0%,
    rgba(31, 107, 92, 0.1) 42%,
    rgba(31, 107, 92, 0) 74%
  );
}

.rail {
  position: relative;
  z-index: 2;
  padding: 12rpx 32rpx;
}

.edge-left .rail {
  padding-left: 28rpx;
}

.edge-right .rail {
  padding-right: 28rpx;
}

.copy {
  font-size: 28rpx;
  font-weight: var(--font-semibold);
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.copy-low {
  color: #5c574c;
}

.copy-inbox {
  color: #16382f;
}

.edge-left.is-armed .frost-1 {
  background: rgba(244, 241, 235, 0.36);
  -webkit-backdrop-filter: blur(32px);
  backdrop-filter: blur(32px);
}

.edge-right.is-armed .frost-1 {
  background: rgba(232, 242, 239, 0.36);
  -webkit-backdrop-filter: blur(32px);
  backdrop-filter: blur(32px);
}

.edge-left.is-armed .wash {
  background: linear-gradient(
    90deg,
    rgba(168, 154, 128, 0.5) 0%,
    rgba(168, 154, 128, 0.22) 18%,
    rgba(168, 154, 128, 0.07) 38%,
    rgba(168, 154, 128, 0) 60%
  );
}

.edge-right.is-armed .wash {
  background: linear-gradient(
    270deg,
    rgba(31, 107, 92, 0.46) 0%,
    rgba(31, 107, 92, 0.2) 18%,
    rgba(31, 107, 92, 0.06) 38%,
    rgba(31, 107, 92, 0) 60%
  );
}

.edge.is-live {
  transition: none;
  -webkit-transition: none;
}
