.bar {
  padding: 16rpx 24rpx 8rpx;
  background: #fffdf9;
  border: 1rpx solid #e8e4dc;
  border-radius: 20rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0 8rpx;
}

.head-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  padding-right: 16rpx;
}

.meta {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(28, 28, 26, 0.05);
}

.row-last {
  margin-bottom: 4rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-live,
.dot-done {
  background: var(--brand-primary);
}

.row-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-status {
  margin-left: 16rpx;
  font-size: var(--font-xs);
  color: var(--brand-primary);
  flex-shrink: 0;
}

.row-arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
  line-height: 1;
  flex-shrink: 0;
}

.empty {
  display: block;
  padding: 16rpx 0 12rpx;
  border-top: 1rpx solid rgba(28, 28, 26, 0.05);
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}
