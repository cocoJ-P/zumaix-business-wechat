.panel {
  padding: 32rpx 32rpx 10rpx;
  background: #efece6;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(28, 28, 26, 0.04);
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.head-left {
  display: flex;
  align-items: baseline;
}

.title {
  font-size: var(--font-lg);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.count {
  margin-left: 10rpx;
  font-size: var(--font-lg);
  font-weight: var(--font-semibold);
  color: var(--brand-primary);
}

.more {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.meta {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0 20rpx;
  border-bottom: 1rpx solid rgba(28, 28, 26, 0.05);
}

.item-last {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.status {
  display: flex;
  align-items: center;
}

.status text {
  font-size: var(--font-xs);
  color: var(--brand-primary);
  letter-spacing: 0.04em;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-live {
  background: var(--brand-primary);
}

.dot-wait {
  background: #c4c1b8;
}

.dot-done {
  background: var(--brand-primary);
  box-shadow: 0 0 0 4rpx rgba(31, 107, 92, 0.12);
}

.status .dot-wait + text {
  color: var(--text-secondary);
}

.status .dot-done + text {
  color: var(--brand-primary);
}

.item-done .item-action {
  color: var(--brand-primary);
}

.run {
  padding: 18rpx 0 12rpx;
  border-bottom: 1rpx solid rgba(28, 28, 26, 0.05);
}

.run-last {
  border-bottom: none;
}

.item-title {
  display: -webkit-box;
  margin-top: 8rpx;
  font-size: var(--font-md);
  font-weight: var(--font-medium);
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-note {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-secondary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-action {
  flex-shrink: 0;
  padding-top: 28rpx;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.empty {
  display: block;
  padding: 28rpx 0 16rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.add {
  display: flex;
  align-items: center;
  padding: 18rpx 0 20rpx;
}

.add-mark {
  margin-right: 8rpx;
  font-size: var(--font-md);
  color: var(--brand-primary);
  line-height: 1;
}

.add-text {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: var(--font-medium);
}
