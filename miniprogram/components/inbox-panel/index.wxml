<view class="bar">
  <view class="head" bindtap="onOpenAll">
    <view class="head-left">
      <text class="meta">为您推荐</text>
    </view>
    <text class="more">全部</text>
  </view>

  <block wx:if="{{analyzingItems.length}}">
    <view
      class="row {{index === analyzingItems.length - 1 && !items.length ? 'row-last' : ''}}"
      wx:for="{{analyzingItems}}"
      wx:key="id"
    >
      <view class="dot dot-live"></view>
      <text class="row-title">{{item.title}}</text>
      <text class="row-status">{{item.statusLabel}}</text>
    </view>
  </block>

  <block wx:if="{{items.length}}">
    <view
      class="row {{index === items.length - 1 ? 'row-last' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="dot dot-done"></view>
      <text class="row-title">{{item.title}}</text>
      <text class="row-arrow">›</text>
    </view>
  </block>
  <text wx:elif="{{!analyzingItems.length}}" class="empty">暂无新的处理结果</text>
</view>
