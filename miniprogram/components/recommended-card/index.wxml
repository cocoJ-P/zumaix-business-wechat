<view class="reco-card reco-card-{{layout}} {{compact ? 'reco-card-compact' : ''}}">
  <view class="reco-meta">
    <text class="reco-status reco-status-{{item.displayStatus || item.status}}">{{item.statusText}}</text>
    <block wx:if="{{!compact}}">
      <text wx:if="{{item.originText}}" class="reco-sep">·</text>
      <text wx:if="{{item.originText}}" class="reco-origin">{{item.originText}}</text>
      <text wx:if="{{item.timeText}}" class="reco-sep">·</text>
      <text wx:if="{{item.timeText}}" class="reco-time">{{item.timeText}}</text>
    </block>
  </view>
  <text wx:if="{{item.statusHint}}" class="reco-hint">{{item.statusHint}}</text>
  <text class="reco-title">{{item.title}}</text>
  <text wx:if="{{!compact && item.preview}}" class="reco-preview">{{item.preview}}</text>
</view>
