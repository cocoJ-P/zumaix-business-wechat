.reco-card {
  box-sizing: border-box;
}

.reco-card-list {
  width: 100%;
  padding: 24rpx 0 22rpx;
  background: transparent;
  border-bottom: 1rpx solid rgba(28, 28, 26, 0.06);
}

.reco-card-compact {
  padding: 18rpx 0;
}

.reco-card-compact .reco-title {
  margin-top: 0;
  font-weight: var(--font-medium);
}

.reco-card-shelf {
  width: 560rpx;
  min-height: 220rpx;
  padding: 28rpx 28rpx 24rpx;
  background: #f7f4ee;
  border: 1rpx solid rgba(31, 107, 92, 0.1);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 28, 26, 0.04);
}

.reco-meta {
  display: flex;
  align-items: baseline;
}

.reco-status {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  letter-spacing: 0.04em;
}

.reco-status-pending,
.reco-status-ingesting,
.reco-status-analyzing,
.reco-status-checking {
  color: var(--brand-primary);
}

.reco-status-succeeded {
  color: var(--text-secondary);
}

.reco-status-failed {
  color: #8a5a52;
}

.reco-sep {
  margin: 0 8rpx;
  color: var(--text-tertiary);
}

.reco-origin,
.reco-time {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.reco-title {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-md);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reco-preview {
  display: -webkit-box;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  overflow: hidden;
  white-space: normal;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
