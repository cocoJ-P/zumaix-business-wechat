.reco-card {
  box-sizing: border-box;
}

.reco-card-list {
  width: 100%;
  padding: 24rpx 0 22rpx;
  background: transparent;
  border-bottom: 1rpx solid rgba(28, 28, 26, 0.06);
}

.reco-card-compact {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(20, 30, 30, 0.05);
}

.reco-card-compact .reco-title {
  margin-top: 8rpx;
  font-weight: var(--font-medium);
}

.reco-card-compact .reco-hint {
  margin-top: 4rpx;
}

.reco-card-shelf {
  width: 560rpx;
  min-height: 220rpx;
  padding: 28rpx 28rpx 24rpx;
  background: #f7f4ee;
  border: 1rpx solid rgba(31, 107, 92, 0.1);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 28, 26, 0.04);
}

.reco-meta {
  display: flex;
  align-items: baseline;
}

.reco-status {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  letter-spacing: 0.04em;
}

.reco-status-pending,
.reco-status-ingesting,
.reco-status-analyzing,
.reco-status-checking,
.reco-status-awaiting_service,
.reco-status-in_progress,
.reco-status-handling {
  color: var(--brand-primary);
}

.reco-status-succeeded {
  color: var(--text-secondary);
}

.reco-status-completed {
  color: var(--status-success);
}

.reco-status-closed {
  color: var(--text-tertiary);
}

.reco-status-failed {
  color: var(--status-danger);
}

.reco-hint {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.4;
}

.reco-sep {
  margin: 0 8rpx;
  color: var(--text-tertiary);
}

.reco-origin,
.reco-time {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.reco-title {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-md);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reco-preview {
  display: -webkit-box;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  overflow: hidden;
  white-space: normal;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.reco-card-inverse {
  background: transparent;
}

.reco-card-inverse .reco-title {
  color: rgba(255, 255, 255, 0.94);
}

.reco-card-inverse .reco-status,
.reco-card-inverse .reco-status-pending,
.reco-card-inverse .reco-status-ingesting,
.reco-card-inverse .reco-status-analyzing,
.reco-card-inverse .reco-status-checking,
.reco-card-inverse .reco-status-awaiting_service,
.reco-card-inverse .reco-status-in_progress,
.reco-card-inverse .reco-status-handling,
.reco-card-inverse .reco-status-succeeded,
.reco-card-inverse .reco-status-completed,
.reco-card-inverse .reco-status-failed,
.reco-card-inverse .reco-status-closed {
  color: rgba(255, 255, 255, 0.68);
}

.reco-card-inverse .reco-origin,
.reco-card-inverse .reco-time,
.reco-card-inverse .reco-sep,
.reco-card-inverse .reco-hint,
.reco-card-inverse .reco-preview {
  color: rgba(255, 255, 255, 0.76);
}

.reco-card-inverse.reco-card-list,
.reco-card-inverse.reco-card-compact {
  background: transparent;
  border-bottom-color: rgba(255, 255, 255, 0.10);
}
