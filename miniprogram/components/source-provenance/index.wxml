<view class="wrap">
  <block wx:if="{{unverified}}">
    <text class="kicker">可信来源</text>
    <text class="warn">可信来源待确认</text>
  </block>
  <block wx:else>
    <text class="kicker">可信来源</text>
    <view wx:for="{{nodes}}" wx:key="role" class="node">
      <text class="role">{{item.role}}</text>
      <text class="name">{{item.name}}</text>
      <view wx:if="{{index < nodes.length - 1}}" class="arrow">↓</view>
    </view>
    <view wx:if="{{publisher}}" class="official">
      <text class="official-label">官方来源</text>
      <text class="official-value">{{publisher}}</text>
    </view>
    <view wx:if="{{document}}" class="official">
      <text class="official-label">正式文件</text>
      <text class="official-value">{{document}}</text>
    </view>
    <view wx:if="{{publishedAt}}" class="official">
      <text class="official-label">发布时间</text>
      <text class="official-value">{{publishedAt}}</text>
    </view>
    <text wx:if="{{verified}}" class="verified">官方来源 · 已核验</text>
  </block>
  <text wx:if="{{showOfficialAction && !unverified}}" class="link" bindtap="onOpenOfficial">查看官方来源</text>
</view>
